{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Loofy147/Bounties/main/schemas/research-record-v1.schema.json",
  "title": "Evidence-driven bounty research record",
  "description": "Portable record contract for a scoped security-research claim. Passing this schema does not establish a vulnerability or bounty eligibility.",
  "type": "object",
  "required": ["schema_version", "target", "claim", "experiment", "evidence", "gates", "program_terms"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "target": {
      "type": "object",
      "required": ["program", "asset", "source_url", "repository", "revision", "eligible_release_confirmed", "in_scope", "scope_snapshot_checked_at", "allowed_environments", "prohibited_actions"],
      "properties": {
        "program": {"type": "string", "minLength": 1},
        "asset": {"type": "string", "minLength": 1},
        "source_url": {"type": "string", "format": "uri", "pattern": "^https://"},
        "repository": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "pattern": "^(?:[0-9a-fA-F]{7,40}|[0-9a-fA-F]{64})$", "description": "Immutable commit/hash; moving refs such as main are not permitted."},
        "eligible_release_confirmed": {"type": "boolean"},
        "in_scope": {"type": "boolean"},
        "scope_snapshot_checked_at": {"type": "string", "format": "date-time"},
        "allowed_environments": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "prohibited_actions": {"type": "array", "items": {"type": "string"}},
        "allowed_actions": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "claim": {
      "type": "object",
      "required": ["id", "status", "title", "hypothesis", "claimed_impact", "first_discovered_at"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "status": {"enum": ["RECONNAISSANCE", "HYPOTHESIS", "REPRODUCED", "IN-SCOPE", "SUBMITTED", "ACCEPTED", "PAID", "REJECTED"]},
        "title": {"type": "string", "minLength": 1},
        "hypothesis": {"type": "string", "minLength": 1},
        "claimed_impact": {"type": "string", "minLength": 1},
        "first_discovered_at": {"type": "string", "format": "date-time"}
      },
      "additionalProperties": false
    },
    "experiment": {
      "type": "object",
      "required": ["environment", "target_matches_scope", "destructive", "uses_public_network", "reproducible", "poc_passed"],
      "properties": {
        "environment": {"type": "string", "minLength": 1},
        "target_matches_scope": {"type": "boolean"},
        "destructive": {"type": "boolean"},
        "uses_public_network": {"type": "boolean"},
        "denial_of_service": {"type": "boolean"},
        "tests_third_party_contracts": {"type": "boolean"},
        "reproducible": {"type": "boolean"},
        "poc_passed": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "target_revision", "observed_at", "reproducible"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "kind": {"type": "string", "minLength": 1},
          "path": {"type": ["string", "null"], "minLength": 1},
          "url": {"type": ["string", "null"], "format": "uri", "pattern": "^https://"},
          "sha256": {"type": ["string", "null"], "pattern": "^[0-9a-fA-F]{64}$"},
          "target_revision": {"type": "string", "pattern": "^(?:[0-9a-fA-F]{7,40}|[0-9a-fA-F]{64})$"},
          "observed_at": {"type": "string", "format": "date-time"},
          "reproducible": {"type": "boolean"}
        },
        "anyOf": [{"required": ["path"]}, {"required": ["url"]}],
        "additionalProperties": false
      }
    },
    "gates": {
      "type": "object",
      "required": ["scope_reviewed", "release_pinned", "known_issues_reviewed", "audits_reviewed", "impact_mapped_to_program", "independent_review_passed", "human_approved", "submission_human_authored", "ai_generated_report", "deadline_checked", "eligibility_confirmed"],
      "properties": {
        "scope_reviewed": {"type": "boolean"},
        "release_pinned": {"type": "boolean"},
        "known_issues_reviewed": {"type": "boolean"},
        "audits_reviewed": {"type": "boolean"},
        "impact_mapped_to_program": {"type": "boolean"},
        "independent_review_passed": {"type": "boolean"},
        "human_approved": {"type": "boolean"},
        "submission_human_authored": {"type": "boolean"},
        "ai_generated_report": {"type": "boolean"},
        "deadline_checked": {"type": "boolean"},
        "eligibility_confirmed": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "program_terms": {
      "type": "object",
      "required": ["poc_required", "report_deadline_hours", "deadline_rule_confirmed", "ai_report_policy", "scope_refresh_max_age_hours"],
      "properties": {
        "poc_required": {"type": "boolean"},
        "report_deadline_hours": {"type": ["number", "null"], "exclusiveMinimum": 0},
        "deadline_rule_confirmed": {"type": "boolean"},
        "ai_report_policy": {"enum": ["allowed", "prohibited", "unknown"]},
        "scope_refresh_max_age_hours": {"type": ["number", "null"], "exclusiveMinimum": 0}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
